# Leave empty for same-origin local requests. A hosted static build must use the
# exact credential-free HTTPS backend origin, without a path, query, or fragment.
VITE_API_BASE_URL=

# Ordinary API timeout in milliseconds. Local development defaults to 10000.
# A Render Free build may set this to 90000 to cover a bounded cold start.
VITE_API_TIMEOUT_MS=10000
