# Application
APP_NAME="Restaurant Ordering & Analytics API"
APP_VERSION=0.1.0
APP_ENVIRONMENT=development
APP_DEBUG=false
APP_TIMEZONE=Europe/Oslo

# Database
POSTGRES_DB=restaurant_ordering_analytics_dev
POSTGRES_USER=restaurant_app
POSTGRES_PASSWORD=
POSTGRES_HOST_PORT=5433

# SQLAlchemy database URL using Psycopg 3.
# Keep this value consistent with POSTGRES_DB, POSTGRES_USER,
# POSTGRES_PASSWORD, and POSTGRES_HOST_PORT.
# Format: postgresql+psycopg://restaurant_app:<password>@127.0.0.1:5433/restaurant_ordering_analytics_dev
DATABASE_URL=

# Used only by isolated integration tests. It must target the local
# restaurant_ordering_analytics_test database on host port 5433. Tests may
# derive it safely from DATABASE_URL by changing only the database name. Never
# commit a test password or connection string.
TEST_DATABASE_URL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:5173/payment/success
STRIPE_CANCEL_URL=http://localhost:5173/cart

# Admin authentication
ADMIN_JWT_SECRET=
ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Frontend URLs
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000
