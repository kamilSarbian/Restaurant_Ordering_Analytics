# Local development only
# Application
APP_NAME="Restaurant Ordering & Analytics API"
APP_VERSION=0.1.0
APP_ENVIRONMENT=development
APP_DEBUG=false
APP_TIMEZONE=Europe/Oslo

# Database
POSTGRES_DB=restaurant_ordering_analytics_dev
POSTGRES_USER=restaurant_app
# Compose embeds this value in an internal DATABASE_URL. Use only URL-safe
# unreserved characters from [A-Za-z0-9._~-] in a long random password.
POSTGRES_PASSWORD=
POSTGRES_HOST_PORT=5433

# Host-only SQLAlchemy database URL using Psycopg 3 for developer tooling.
# Keep this value consistent with POSTGRES_DB, POSTGRES_USER,
# POSTGRES_PASSWORD, and POSTGRES_HOST_PORT.
# Format: postgresql+psycopg://restaurant_app:<password>@127.0.0.1:5433/restaurant_ordering_analytics_dev
# Compose constructs separate service-scoped runtime and migration URLs from
# POSTGRES_*. Local development deliberately uses the same local credential for
# both, so no second password or DSN is required in the real local .env.
DATABASE_URL=

# Used only by isolated integration tests. It must target the local
# restaurant_ordering_analytics_test database on host port 5433. Tests may
# derive it safely from DATABASE_URL by changing only the database name. Never
# commit a test password or connection string.
TEST_DATABASE_URL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:5173/orders/{public_order_number}/payment-return
STRIPE_CANCEL_URL=http://localhost:5173/orders/{public_order_number}/checkout-cancelled

# Authentication
# Generate at least 32 bytes of random key material and never commit a real
# secret.
AUTH_JWT_SECRET=
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Frontend
# Leave empty for same-origin /api requests through Vite or the Compose Nginx.
VITE_API_BASE_URL=

# Production-only contract
# Configure these values in the provider environment or secret manager, never
# by copying this local file. The examples below are sanitized placeholders and
# intentionally commented out.
#
# APP_ENVIRONMENT=production
# APP_DEBUG=false
# DATABASE_URL=<private-provider-postgresql-url>
# MIGRATION_DATABASE_URL=<private-internal-roa-migrator-postgresql-url>
# MIGRATION_EXPECTED_LOGIN_ROLE=roa_migrator
# MIGRATION_OWNER_ROLE=roa_owner
# AUTH_JWT_SECRET=<at-least-32-random-bytes>
# STRIPE_SECRET_KEY=<stripe-test-or-restricted-test-key>
# STRIPE_WEBHOOK_SECRET=<stripe-test-endpoint-signing-secret>
# STRIPE_SUCCESS_URL=https://restaurant.example/orders/{public_order_number}/payment-return
# STRIPE_CANCEL_URL=https://restaurant.example/orders/{public_order_number}/checkout-cancelled
# PUBLIC_APP_ORIGIN=https://restaurant.example
# TRUSTED_HOSTS=["restaurant.example"]
# TRUSTED_PROXY_MODE=direct
# STRIPE_EXPECTED_LIVEMODE=false
# EXPECTED_ALEMBIC_HEAD=0008_add_order_ownership
# RELEASE_SHA=<40-character-lowercase-git-sha>
# LOG_LEVEL=INFO
#
# MIGRATION_DATABASE_URL is a secret for the dedicated migration executor only
# and must never be provided to the runtime backend. Migration role names are
# non-secret identifiers. Never commit a real database URL.
#
# Production must not receive local POSTGRES_* variables, TEST_DATABASE_URL,
# or any E2E_* variable. Never commit real secrets or provider credentials.
# VITE_* variables are browser-visible and must never contain backend secrets.
